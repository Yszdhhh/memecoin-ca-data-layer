DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
REDIS_URL=redis://HOST:6379
HELIUS_API_KEY=YOUR_HELIUS_API_KEY
BITQUERY_API_KEY=YOUR_BITQUERY_API_KEY
BSC_RPC_URL=https://YOUR_BSC_RPC_HOST
ROBINHOOD_RPC_URL=https://YOUR_ROBINHOOD_RPC_HOST

# Coinalyze (CEX perpetual liquidation history for macro:liquidity:snapshot).
# Optional: without it the liquidation metrics fail closed (unavailable + warning).
COINALYZE_API_KEY=YOUR_COINALYZE_API_KEY
