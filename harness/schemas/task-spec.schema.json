{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memecoin-task-spec-v1",
  "type": "object",
  "required": [
    "schema_version", "task_id", "title", "tier", "role", "chain", "status",
    "objective", "dependencies", "inputs", "write_set", "forbidden_actions",
    "deliverables", "acceptance_commands"
  ],
  "properties": {
    "schema_version": { "const": "task-v1" },
    "task_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,63}$" },
    "tier": { "enum": ["T1", "T2", "T3"] },
    "role": { "enum": ["coordinator", "implementer", "researcher", "auditor"] },
    "chain": { "type": ["string", "null"], "enum": ["solana", "bsc", "robinhood", null] },
    "status": { "enum": ["READY", "BLOCKED_DEPENDENCY", "BLOCKED_STAGE", "IN_PROGRESS", "DONE", "PARK"] },
    "dependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "inputs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "write_set": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "forbidden_actions": { "type": "array", "items": { "type": "string" } },
    "deliverables": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "acceptance_commands": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
  },
  "additionalProperties": false
}
